APP_NAME="Laravel API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Minutes an account must stay clear AFTER a meeting ends before hosting the next.
# Any non-zero value blocks back-to-back bookings on one account: with 20, a
# 10:00-11:00 meeting blocks an 11:00 start. Use 0 for lessons scheduled on the hour.
ZOOM_MEETING_BUFFER_MINUTES=20

# Longest any meeting may be, in minutes. Enforced when validating an event's
# duration, when sending that duration to Zoom, and when deciding how long an existing
# meeting occupies an account. Some accounts hold meetings created with placeholder
# durations of 9999 or 999999 minutes (7 and 694 days) that would otherwise block them
# for weeks or years.
ZOOM_MAX_MEETING_MINUTES=240
ZOOM_LIVE_UNKNOWN_WINDOW_MINUTES=30
ZOOM_NO_SHOW_GRACE_MINUTES=15

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=password

# EuPlatesc Payment Gateway
EU_PLATESC_MID=
EU_PLATESC_KEY=
EU_PLATESC_TEST_MODE=true
EUR_TO_RON_RATE=4.95

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@ab-academy.com
MAIL_FROM_NAME="${APP_NAME}"
LOG_AUTH_EVENTS_TO_DATABASE=false
